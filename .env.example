# =============================================================================
# Customer Pain Research Agent — Environment Variables
# Copy this file to .env and fill in the keys you have.
# At minimum you need: (1) Reddit data source + (2) one LLM provider.
# =============================================================================

# --- Reddit data (preferred: Apify) ---
# Get a free token at https://console.apify.com/account/integrations
APIFY_TOKEN=

# Optional: override the default Apify actor (trudax/reddit-scraper-lite)
# APIFY_REDDIT_ACTOR=trudax/reddit-scraper-lite

# --- Reddit data (fallback: official PRAW / Reddit API) ---
# Create an app at https://www.reddit.com/prefs/apps  (type: "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=CustomerPainResearchAgent/1.0 by your_username

# --- LLM providers (at least ONE required) ---
# Preference order when multiple are set: Anthropic → OpenAI → Perplexity

# Anthropic Claude (recommended): https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI GPT: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Perplexity (web-grounded optional alternative): https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar-pro

# --- Optional defaults ---
# LOG_LEVEL=INFO
# OUTPUT_DIR=output
